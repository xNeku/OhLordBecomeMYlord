[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/ui/main_menu.gd" id="1_menu"]

[sub_resource type="StyleBoxFlat" id="Style_panel"]
bg_color = Color(0.03, 0.03, 0.04, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.65, 1, 0.18, 0.5)
content_margin_left = 28.0
content_margin_top = 22.0
content_margin_right = 28.0
content_margin_bottom = 22.0

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_menu")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Panel" type="PanelContainer" parent="Center"]
layout_mode = 2
theme_override_styles/panel = SubResource("Style_panel")

[node name="Box" type="VBoxContainer" parent="Center/Panel"]
custom_minimum_size = Vector2(360, 0)
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Center/Panel/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 1, 0.18, 1)
theme_override_font_sizes/font_size = 22
text = "ORCOS vs. ALIANZA"
horizontal_alignment = 1

[node name="Sub" type="Label" parent="Center/Panel/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.52, 0.56, 1)
text = "prototipo · título provisional"
horizontal_alignment = 1

[node name="Campaign" type="Button" parent="Center/Panel/Box"]
layout_mode = 2
text = "Campaña Goblins · Mapa 1"

[node name="SeedRow" type="HBoxContainer" parent="Center/Panel/Box"]
layout_mode = 2

[node name="Label" type="Label" parent="Center/Panel/Box/SeedRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Semilla del mapa"

[node name="Seed" type="SpinBox" parent="Center/Panel/Box/SeedRow"]
layout_mode = 2
max_value = 999999.0
value = 12345.0

[node name="RandomSeed" type="Button" parent="Center/Panel/Box/SeedRow"]
layout_mode = 2
text = "Aleatoria"

[node name="Benchmark" type="Button" parent="Center/Panel/Box"]
layout_mode = 2
text = "Hito 0 · Benchmark de rendimiento"

[node name="Quit" type="Button" parent="Center/Panel/Box"]
layout_mode = 2
text = "Salir"

[connection signal="pressed" from="Center/Panel/Box/Campaign" to="." method="_on_campaign_pressed"]
[connection signal="pressed" from="Center/Panel/Box/SeedRow/RandomSeed" to="." method="_on_random_seed_pressed"]
[connection signal="pressed" from="Center/Panel/Box/Benchmark" to="." method="_on_benchmark_pressed"]
[connection signal="pressed" from="Center/Panel/Box/Quit" to="." method="_on_quit_pressed"]
